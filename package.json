{
  "name": "life-quest-journal",
  "version": "3.0.0",
  "description": "Transform your life goals into epic quests. Track habits, earn rewards, and level up your life!",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o tailwind.css --watch",
    "fetch:vendor": "node scripts/fetch-vendor.js",
    "copy:web": "npm run build:css && node scripts/copy-web.js",
    "cap:sync": "npm run copy:web && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run copy:web && npx cap sync android && npx cap open android",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "productivity",
    "goals",
    "tasks",
    "habits"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^26.1.0",
    "babel-jest": "^30.5.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-app-update": "^8.0.3"
  }
}
